import abc
import collections.abc
import types
import typing
from collections.abc import AsyncIterator, Iterator
from types import TracebackType
from typing import (
    TypeVar,
    final,
    overload,
)

from _typeshed import Unused

_S = TypeVar("_S", bound="Foo")
T = typing.TypeVar("T")
NotTypeVar = int


class GoodExit:
    def __exit__(self, typ: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None) -> None: ...
    async def __aexit__(
        self, typ: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None
    ) -> None: ...


class ObjectExit:
    def __exit__(self, *args: object) -> None: ...
    async def __aexit__(self, typ: object, exc: Unused, tb: "object") -> None: ...


class StarArgs:
    def __exit__(self, *args: object) -> None: ...
    async def __aexit__(self, *args) -> None: ...


class MissingArgs:
    def __exit__(self, typ, exc) -> None: ...
    async def __aexit__(self) -> None: ...


class BadAnnotations:
    def __exit__(self, typ: BaseException, exc: Exception | None, tb: types.TracebackType) -> None: ...
    async def __aexit__(
        self, typ: "type[BaseException] | None", exc: "BaseException | None", tb: "TracebackType | None"
    ) -> None: ...


class NoneOnly:
    def __exit__(self, typ: None, exc: "None", tb: None | None) -> None: ...


class ExtraArgs:
    def __exit__(self, typ: object, exc: object, tb: object, extra, more=None, *, flag, other=1) -> None: ...


class WrongColor:
    async def __exit__(self, typ) -> None: ...
    def __aexit__(self, typ) -> None: ...


def __exit__(typ) -> None: ...


class Conditional:
    if True:
        def __exit__(self, typ) -> None: ...


class Overloaded:
    @overload
    def __exit__(self, typ: None, exc: None, tb: None) -> None: ...
    @overload
    def __exit__(self, typ: type[BaseException], exc: BaseException, tb: TracebackType) -> None: ...
    def __exit__(self, typ: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None) -> None: ...


class BadOverload:
    @overload
    def __exit__(self, typ: None, exc: None, tb: None) -> None: ...
    @overload
    def __exit__(self, typ: int, exc: BaseException, tb: TracebackType) -> None: ...
    def __exit__(self, *args: object) -> None: ...


class ThreeOverloads:
    @overload
    def __exit__(self, typ: None, exc: None, tb: None) -> None: ...
    @overload
    def __exit__(self, typ: int, exc: int, tb: int) -> None: ...
    @overload
    def __exit__(self, typ: str, exc: str, tb: str) -> None: ...
    def __exit__(self, *args: object) -> None: ...


class Shape:
    def __new__(cls, *args) -> typing.Self: ...
    def __enter__(self) -> typing.Self: ...
    async def __aenter__(self) -> typing.Self: ...
    def __iadd__(self, other) -> typing.Self: ...
    def __ior__(self, other) -> typing.Self: ...
    async def __imul__(self, other) -> Shape: ...
    def __add__(self, other) -> Shape: ...
    def method(self) -> Shape: ...
    def __enter_unannotated__(self): ...
    def __aenter__(self) -> Shape: ...
    @abc.abstractmethod
    def __isub__(self, other) -> Shape: ...
    @typing.overload
    def __imatmul__(self, other: int) -> Shape: ...
    @staticmethod
    def __new__() -> Shape: ...
    def __enter__(self) -> Other: ...


class Other:
    pass


@final
class Sealed:
    def __enter__(self) -> Sealed: ...
    def __iadd__(self, other) -> typing.Self: ...
    async def __aenter__(self) -> Sealed: ...
    def __new__(cls) -> Sealed: ...


@typing.final
class SealedQualified:
    def __enter__(self) -> SealedQualified: ...


class Iter(Iterator[int]):
    def __iter__(self) -> typing.Self: ...
    def __next__(self) -> int: ...


class IterAbc(collections.abc.Iterator):
    def __iter__(self) -> typing.Self: ...


class NotIter:
    def __iter__(self) -> Iterator[int]: ...


class AsyncIter(typing.AsyncIterator[int]):
    def __aiter__(self) -> typing.Self: ...


class AsyncIterAsync(AsyncIterator[int]):
    async def __aiter__(self) -> AsyncIterator[int]: ...


class SubIter(Iter):
    def __iter__(self) -> typing.Self: ...


class Meta(type):
    def __new__(cls, name, bases, namespace) -> Meta: ...


class MetaAbc(abc.ABCMeta):
    def __enter__(self) -> MetaAbc: ...


class MaybeMeta(Shape):
    def __new__(cls, name: str, bases: tuple[type, ...], attrs: dict[str, object], **kwargs) -> MaybeMeta: ...


class Dynamic(type(Shape)):
    def __enter__(self) -> Dynamic: ...


class SubMeta(Meta):
    def __enter__(self) -> SubMeta: ...


def __enter__(self) -> Shape: ...


class Outer:
    class Inner:
        def __enter__(self) -> typing.Self: ...

    if True:
        def __enter__(self) -> typing.Self: ...


class Foo:
    def __new__(cls: type[_S], *args) -> _S: ...
    def foo(self: _S, arg: bytes) -> _S: ...
    def no_return(self: _S) -> None: ...
    @classmethod
    def bar(cls: type[_S], arg: int) -> _S: ...
    @classmethod
    def typing_type(cls: type[_S]) -> _S: ...
    @staticmethod
    def static(value: _S) -> _S: ...
    def quoted(self: "_S") -> _S: ...
    def not_type_var(self: NotTypeVar) -> None: ...
    def generic[S](self: S) -> S: ...
    def bounded[S: Foo](self: S, value: int) -> S: ...
    @abc.abstractmethod
    def abstract(self: _S) -> _S: ...
    @overload
    def overloaded(self: _S) -> _S: ...
    def __init_subclass__(cls: type[T]) -> None: ...
    def unannotated(self, value: _S) -> _S: ...
    def multiline(
        self: _S,
        value: int,
    ):
        return self


def free(value: _S) -> _S: ...


class MetaSelf(type):
    def method(cls: _S) -> _S: ...


class UnionTypes:
    field: type[int] | type[str]
    other: type[int] | type[str] | None

    def method(self, kind: type[int] | type[float] | str) -> None:
        local: type[int | str] = int
        print(local)


alias = type[int] | type[str]
quoted: "type[int | str]"
