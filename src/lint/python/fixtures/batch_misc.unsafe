from __future__ import annotations

import functools
import math
import operator
from functools import cache, lru_cache
from typing import Any


def flatten(groups):
    first = functools.reduce(operator.iadd, groups, [])
    second = functools.reduce(operator.iadd, groups, [])
    third = sum(groups, ())
    fourth = functools.reduce(operator.iadd, groups, [])
    fifth = sum(groups, [1])
    sixth = sum(groups)
    return first, second, third, fourth, fifth, sixth


letters = {"a", "b", "c"}
numbers = {1, 2}
names = {letters, letters, flatten}
calls = {flatten(), flatten()}
empty = set()


def checks(value, other):
    if isinstance(value, (int, str)):
        pass
    if isinstance(value, int) or isinstance(other, int) or isinstance(value, float):
        pass
    if isinstance(value, (int, float, str)):
        pass
    if isinstance(value, int) and isinstance(value, str):
        pass
    if isinstance(value, int) or isinstance(value, str, extra=1):
        pass
    if isinstance(value.x, (int, str)):
        pass


class Service:
    @lru_cache
    def bare(self):
        return 1

    @lru_cache(maxsize=10)
    def called(self):
        return 1

    @functools.cache
    def qualified(self):
        return 1

    @cache
    @staticmethod
    def static():
        return 1

    @classmethod
    @functools.lru_cache
    def klass(cls):
        return 1


@lru_cache
def module_function():
    return 1


def redefinitions(item, path, error, handle, _ignored):
    for item in range(3):
        print(item)
    with open(path) as handle:
        print(handle)
    try:
        pass
    except ValueError as error:
        print(error)
    for _ignored in range(2):
        pass
    for (path, other) in []:
        print(path, other)

    def inner(value):
        for item in range(value):
            print(item)

    return inner


def conversions(value, items):
    first = 1
    second = len(items)
    third = round(value)
    fourth = int(round(value, 2))
    fifth = math.floor(value)
    sixth = math.ceil(value)
    seventh = int(value)
    eighth = int(value)
    ninth = round(value, None)
    tenth = math.trunc(value)
    eleventh = ord("a")
    return first, second, third, fourth, fifth, sixth, seventh, eighth, ninth, tenth, eleventh


