import ctypes
import dataclasses
from collections.abc import Sequence
from typing import ClassVar, Final

import pydantic


class Plain:
    items = []
    mapping = {}
    flags = set()
    numbers = (1, 2)
    __slots__ = []
    first = second = []
    typed: list = []
    sequence: Sequence[int] = []
    shared: ClassVar[list] = []
    constant: Final = []
    bare: ClassVar = []
    shared = []
    nothing: list


@dataclasses.dataclass
class Data:
    items: list = []
    other = []


class Model(pydantic.BaseModel):
    items: list = []


class Derived(Model):
    items = []


class Point(ctypes.Structure):
    before = []
    _fields_ = [("x", ctypes.c_int)]
    after = []


def factory():
    class Local:
        items = []

    return Local


__all__ = ["a", "b"]
__all__ = ["CONSTANT", "Class", "function"]
__all__ = ["Class", "function"]
__all__ += ["y", "z"]
__all__.extend(("item2", "item10"))
__all__.extend(("item2", "item10"))
__all__ = "a", "b"
__all__ = ["a", "b", "c"]
__all__ = ["a" "z", "b"]
__all__ = ["A01", "A1"]
__all__: list[str] = ["c", "d"]
other = __all__ = ["b", "a"]


def scoped():
    __all__ = ["b", "a"]
    return __all__


class Slotted:
    __slots__ = ("breed", "name")
    __slots__ = {"a": "doc", "b": "doc"}
    __slots__ = {"a", "b"}
    __slots__ = ["Zeta", "alpha"]
    __slots__ = ["B", "a"]
