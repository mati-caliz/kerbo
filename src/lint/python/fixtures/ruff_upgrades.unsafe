@dataclass
class Data:
    items: list[int] = []
    mapping: dict = {}
    fixed: ClassVar[list[int]] = []
    tupled: tuple[int, ...] = ()
    plain = []
    factory: list[int] = field(default_factory=list)
    defaulted: list[int] = field(default=[])


@dataclasses.dataclass(frozen=True)
class Frozen:
    values: set[int] = set()


class NotData:
    items: list[int] = []


