@functools.lru_cache
def cached():
    return 1


@lru_cache
def cached_too():
    return 1


@functools.cache
def bounded():
    return 1


@lru_cache
def plain():
    return 1


class Holder:
    @functools.lru_cache
    def method(self):
        return 1
