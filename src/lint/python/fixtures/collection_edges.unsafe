items = [3, 1, 2]
flag = True
first = sorted(items, reverse=False)
second = sorted(items, reverse=flag)
third = sorted(items, reverse=not flag)
fourth = sorted((x for x in items), reverse=True)
fifth = sorted(items, key=len,reverse=True)
sixth = sorted(items)
