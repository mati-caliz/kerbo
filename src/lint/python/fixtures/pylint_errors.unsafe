class Dispatcher:
    @singledispatchmethod
    def method(self, arg):
        pass

    @singledispatchmethod
    @staticmethod
    def static(arg):
        pass

    @singledispatchmethod
    def right(self, arg):
        pass


@singledispatch
def function(arg):
    pass


@singledispatch
def other_function(arg):
    pass


@singledispatch
def fine(arg):
    pass


async def async_generator():
    yield from range(3)


async def nested_async():
    def inner():
        yield from range(3)

    return inner


def outer_sync():
    async def inner():
        yield from range(3)

    return inner


