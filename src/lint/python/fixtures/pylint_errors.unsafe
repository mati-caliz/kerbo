logger = logging.getLogger(__name__)


class Generator:
    def __init__(self):
        yield 1

    def method(self):
        yield 2


class GeneratorFrom:
    def __init__(self):
        yield from range(3)


def __init__():
    yield 3


class Nested:
    def __init__(self):
        def inner():
            yield 4

        self.inner = inner
        self.values = [(yield) for _ in range(1)]


counter = 0


def outer():
    value = 1

    def inner():
        global value
        nonlocal value
        value = 2

    return inner


def load_before_global():
    print(counter)
    global counter
    counter = 1


def delete_before_global():
    del counter
    global counter
    counter = 4


def except_before_global():
    try:
        pass
    except ValueError:
        pass
    with open("file") as counter:
        pass
    global counter
    counter = 5


def global_first():
    global counter
    print(counter)


global counter


def continue_in_finally():
    for _ in range(3):
        try:
            pass
        finally:
            continue


def keywords(**kwargs):
    return kwargs


keywords(a=1, **{"a": 2})
keywords(**{"a": 1, "a": 2})
keywords(**{"a": 1}, **{"a": 2})
keywords(a=1, **{"b": 2, "a": 3}, c=4)
keywords(a=1, b=2)
keywords(**{1: 1, 1: 2})


