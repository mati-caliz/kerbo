with threading.Lock():
    pass
with threading.RLock() as lock:
    pass
with Lock():
    pass
with threading.Condition(), threading.Semaphore():
    pass
with open("file"), threading.BoundedSemaphore():
    pass
with lock:
    pass
with threading.Event():
    pass


def first_iterable():
    return [x for x in [(yield 1)]], [y for y in range(2) for z in [(yield 2)]]
