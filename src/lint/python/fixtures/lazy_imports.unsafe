def generic[T: int = int, **P = int, *Ts = int](value: T) -> T:
    return value


class Box[T = str]:
    value: T


def splatted(args, kwargs):
    return args[*kwargs, *(kwargs.values())]


def annotated(first: f"{missing_name}", second: t"{other_missing}"):
    return first, second


def typed_slice(value: tuple[:, 1], other: list[:]):
    return value, other


def quoted() -> 'None':
    return None


def pattern(value):
    match value:
        case +0:
            return 1
        case +0.25 + 1.75j:
            return 2
    return 3


