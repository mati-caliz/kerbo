def corpus_cases(values, **kwargs):
    for key in kwargs:
        print(kwargs[key])
    grid = {(1, 2): 3}
    for row, column in grid:
        print(grid[(row, column)])
    first, rows = values, []
    for row in values:
        rows.append(row)
    later = []
    for row in values:
        later.append(row)
    later = None
    jobs = {}
    for job in jobs:
        print(jobs[job])
        del jobs[job]
    return (sorted(values))[0], later


async def asynchronous(values):
    results = []
    async for value in values:
        results.append(value)
    return results


def test_nested_warns(optional: dict | None):
    with pytest.warns(UserWarning):
        with pytest.raises(ValueError):
            print("one")
    with pytest.warns(UserWarning):
        with pytest.raises(ValueError):

            class Inside:
                pass

    for key in optional:
        print(optional[key])


def nested_indexes(column):
    table = {}
    for name in table:
        print(table[name][column])
    for name in table:
        table[name][column] = 1
