def dictionaries(items: dict, unknown, values):
    mapping = {"a": 1}
    built = dict(a=1)
    for key in mapping:
        print(mapping[key])
    for key in built:
        print(key, built[key])
    for key in items:
        print(items[key])
    for key in unknown:
        print(unknown[key])
    for key in mapping:
        print(mapping[key])
    for key in mapping:
        mapping[key] = 1
    result = []
    for value in values:
        result.append(value)
    other = []
    for value in values:
        other.append(value + 1)
    for value in values:
        if value:
            result.append(value)
    if mapping.get("key"):
        pass
    mapping.pop("key", None)
    return {"static": value for value in values}, {value: value for value in values}


def numbers(values, a, b, c, text):
    return (
        sorted(values)[0],
        sorted(values)[-1],
        sorted(values, reverse=True)[0],
        sorted(values)[1],
        a < b < c,
        a < b and c < b,
        a > b > c,
        a < b and b > c,
        1,
        1,
        round(1, -1),
        round(a),
        round(1.5),
        int(text[2:], 16),
        int(text[2:], 10),
        int(text[1:], 16),
        text.strip("xyz"),
        text.strip("xx"),
        text.lstrip("a"),
        text.rstrip(".txt"),
    )


