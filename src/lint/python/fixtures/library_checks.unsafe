async def trio_calls():
    await trio.sleep(1)
    await trio.sleep(1)
    await (trio.sleep(1))
    await trio.lowlevel.checkpoint()
    await trio.open_file("x")
    trio.current_time()
    await trio.sleep_forever()
    await trio.sleep(86400)
    await trio.sleep_forever()
    await anyio.sleep_forever()
    await anyio.sleep_forever()
    await trio.sleep(1, 2)


def sync_trio():
    trio.sleep(1)


async def blocking():
    requests.get("url")
    httpx.post("url")
    urllib.request.urlopen("url")
    requests.Session()
    subprocess.Popen(["ls"])
    os.popen("ls")
    subprocess.run(["ls"])
    os.system("ls")
    subprocess.check_output(["ls"])
    os.spawnl(os.P_NOWAIT, "ls")
    os.spawnl(os.P_WAIT, "ls")
    os.spawnl()

    def inner():
        requests.get("url")

    return inner


def not_async():
    requests.get("url")
    subprocess.run(["ls"])


