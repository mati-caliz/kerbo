def finally_return():
    try:
        return 1
    except ValueError:
        pass
    finally:
        return 2


def finally_after_except():
    try:
        pass
    except ValueError:
        return 1
    finally:
        return 2


def finally_without():
    try:
        pass
    finally:
        return 3


