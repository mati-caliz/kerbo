import collections
import dataclasses
import datetime
from collections.abc import Sequence
from typing import NewType

UserId = NewType("UserId", int)


def mutable(a=None, b=None, c=None, d=None, e=None, f=(), g=None):
    if e is None:
        e = list[int]()
    if d is None:
        d = collections.deque()
    if c is None:
        c = set()
    if b is None:
        b = {}
    if a is None:
        a = []
    return a, b, c, d, e, f, g


def annotated(a: Sequence[int] = [], b: int | None = 0, c: int | str = len("x"), d: int | None = len("x")):
    return a, b, c, d


def calls(a=len("x"), b=datetime.datetime.now(), c=datetime.timedelta(1), d=UserId(1), e=lambda: len("x")):
    return a, b, c, d, e


def nested(a=None):
    if a is None:
        a = [len(x) for x in "ab"]
    return a


def handler(a=len("x"), b=None):
    if b is None:
        b = []
    return (a, b)


class Base:
    pass


class Child(Base):
    def __init__(self):
        super().__init__()
        super().__init__()
        super(Base, self).__init__()

    def other(this):
        super().__init__()
        super(Child, self).__init__()

    def shadowed(self):
        Child = Base
        super(Child, self).__init__()

    def cell(self):
        super().__init__()

    class Inner(Base):
        def method(self):
            super().__init__()
            super(Inner, self).__init__()

    def comprehension(self):
        return [super(Child, self) for _ in range(1)]


@dataclasses.dataclass(slots=True)
class Slotted(Base):
    def method(self):
        super(Slotted, self).__init__()


def ranges(values):
    for index in range(10):
        print(index)
    for index in range(0, 10, 2):
        print(index)
    for index in range(1, 10):
        print(index)
    return range(len(values))


def attributes(target, name):
    first = target.value
    second = getattr(target, name)
    third = getattr(target, "not valid")
    fourth = getattr(target, "__private")
    fifth = target.__dunder__
    sixth = getattr(target, "value", None)
    target.value = 1
    result = setattr(target, "value", 1)
    setattr(target, "__debug__", 1)
    setattr(target, "class", 1)
    return first, second, third, fourth, fifth, sixth, result


def first_elements(values):
    return [
        next(iter(values)),
        next(iter(values)),
        list(values)[1],
        next(iter(values)),
        next(iter(values)),
        next(iter(values)),
        next(iter(values)),
        min(values),
        next(iter(values)),
    ]
