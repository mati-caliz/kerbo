import decimal
import sys
from decimal import Decimal
from decimal import Decimal as D
from typing import TYPE_CHECKING


def positive(x):
    return x > 0


def inverted(x):
    return not x > 0


def chained(x):
    if x > 0:
        return 1
    return x < 0


def same(x):
    if x:
        return True
    return True


def commented(x):
    if x:  # comentario
        return True
    # otro
    return False


def parenthesized(x):
    return bool(x)


def with_more(x):
    if x:
        print(x)
        return True
    return False


def not_return(x):
    if x:
        return True
    print(x)


def only_elif(x):
    if x:
        return True
    elif not x:
        return False


def version():
    if sys.version_info >= (3, 11):
        return True
    return False


def checking():
    if TYPE_CHECKING:
        return True
    return False


def platform():
    if x and sys.platform == "linux":
        return False
    return True


