import enum
import itertools
import os
from typing import TypeVar

T = TypeVar("T", covariant=True)
U = TypeVar("U", contravariant=True)
V_co = TypeVar("V_co")
W_contra = TypeVar("W_contra", covariant=True)
X_co = TypeVar("X_co", covariant=True)
Y = TypeVar("Y")
Z = TypeVar("Z", bound=int, covariant=True, contravariant=True)
named: str = "a"
qualified: str = "b"


def bounds(value, highest, lowest, items):
    highest = max(highest, value)
    lowest = min(lowest, value)
    highest = max(highest, value)
    highest = max(value, highest)
    if value > highest:
        highest = value
    else:
        pass
    if value > highest:
        highest = other = value
    items[0] = max(items[0], value)
    highest.y = max(highest.y, value.x)
    return highest, lowest, other


def dictionaries(mapping):
    for key, value in mapping.items():
        print(value)
    for key, value in mapping.items():
        print(key)
    for key in mapping:
        print(key)
    for value in mapping.values():
        print(value)
    for key, value in mapping.items():
        print(key, value)
    for (key, value) in mapping.items():
        print(value)


def casts(items):
    return (
        list(items),
        list(items),
        set(items),
        sorted(items),
        sorted(sorted(items, reverse=True)),
        tuple(reversed(items)),
        set(items),
        sorted(items),
        sorted(items),
        {item for item in items},
        {item: item for item in items},
        [item for item in items],
        {},
        {"a": 1},
        set({item for item in items}),
    )


def booleans(x, y):
    return (
        x or True,
        x or True,
        x and False,
        y and False,
        bool(x),
        bool(y),
        not x,
        bool(x),
        x or [1],
        x or "",
        "value" if x else "value",
        1 if x else 2,
    )


def environment():
    return os.getenv("A", 1), os.getenv("B", "1"), os.getenv("C", None), os.getenv("D", default=2.0)


def pairs(items):
    return itertools.pairwise(items), zip(items, items[2:]), zip(items[1:], items), list(itertools.pairwise(items))


def errors():
    try:
        pass
    except 1:
        pass
    try:
        pass
    except (ValueError, "text"):
        pass
    raise "boom"


def asserts(value):
    assert "always"
    assert ""
    assert value, "message"
    return value == float("nan"), value != float("NaN"), value == float("inf")


def spreads(base):
    return {**base, "a": 1}, {**base, }, {"b": 2}


class Methods:
    def __init__(self):
        return 1

    def __len__(self):
        return "2"

    def __bool__(self):
        return 1

    def __index__(self):
        return "x"

    def __str__(self):
        return 3

    def __bytes__(self):
        return "text"

    def __hash__(self):
        return 1.5

    @property
    def size(self, scale):
        return scale


class Correct:
    def __init__(self):
        return None

    def __len__(self):
        return 2

    def __bool__(self):
        return False

    def __index__(self):
