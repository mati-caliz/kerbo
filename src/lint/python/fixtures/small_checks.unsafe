    try:
        pass
    except 1:
        pass
    try:
        pass
    except (ValueError, "text"):
        pass
    raise "boom"


def asserts(value):
    assert "always"
    assert ""
    assert value, "message"
    return value == float("nan"), value != float("NaN"), value == float("inf")


def spreads(base):
    return {**base, **{"a": 1}}, {**base, **{}}, {**{"b": 2}}


