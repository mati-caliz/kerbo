class Color(enum.Enum):
    RED = 1
    GREEN = 2
    BLUE = 1
    OTHER = "a"
    LAST = "a"


from enum import Enum as AliasedEnum


class Aliased(AliasedEnum):
    ONE = 1
    UNO = 1


class Implicit:
    def __bool__(self):
        assert False

    def __len__(self):
        raise NotImplementedError

    def __index__(self):
        ...

    def __hash__(self):
        raise TypeError("unhashable")


def more(cache, environment, values):
    for key, (send, close) in cache.items():
        print(key)
    try:
        pass
    except (ValueError,) + values:
        pass
    return (
        environment.get("A", 1),
        TypeVar(name="Name", covariant=True),
        TypeVar("Inferred", covariant=True, infer_variance=True),
        not 1 and 1 and 1,
    )


def nested_scope(mapping):
    for path, args in mapping.items():
        print(args)

    def inner(path):
        return path

    return inner
