import enum
import os
from typing import TypeVar

T = TypeVar("T", covariant=True)
U = TypeVar("U", contravariant=True)
V_co = TypeVar("V_co")
W_contra = TypeVar("W_contra", covariant=True)
X_co = TypeVar("X_co", covariant=True)
Y = TypeVar("Y")
Z = TypeVar("Z", bound=int, covariant=True, contravariant=True)
named: str = "a"
qualified: str = "b"


def bounds(value, highest, lowest, items):
    if value > highest:
        highest = value
    if value < lowest:
        lowest = value
    if highest < value:
        highest = value
    if value >= highest:
        highest = value
    if value > highest:
        highest = value
    else:
        pass
    if value > highest:
        highest = other = value
    if value > items[0]:
        items[0] = value
    if value.x > highest.y:
        highest.y = value.x
    return highest, lowest, other


def dictionaries(mapping):
    for key, value in mapping.items():
        print(value)
    for key, value in mapping.items():
        print(key)
    for key, _ in mapping.items():
        print(key)
    for _, value in mapping.items():
        print(value)
    for key, value in mapping.items():
        print(key, value)
    for (key, value) in mapping.items():
        print(value)


def casts(items):
    return (
        list(list(items)),
        list(tuple(items)),
        set(sorted(items)),
        sorted(list(items)),
        sorted(sorted(items, reverse=True)),
        tuple(reversed(items)),
        set(reversed(items)),
        list(sorted(items)),
        sorted(reversed(items)),
        set([item for item in items]),
        dict([(item, item) for item in items]),
        list([item for item in items]),
        dict({}),
        dict({"a": 1}),
        set({item for item in items}),
    )


def booleans(x, y):
    return (
        x or True,
        x or True or y,
        x and False,
        y and False and x,
        not not x,
        not (not y),
        False if x else True,
        True if x else False,
        x or [1],
        x or "",
        "value" if x else "value",
        1 if x else 2,
    )


def environment():
    return os.getenv("A", 1), os.getenv("B", "1"), os.getenv("C", None), os.getenv("D", default=2.0)


def pairs(items):
    return zip(items, items[1:]), zip(items, items[2:]), zip(items[1:], items), list(zip(items, items[1:]))


