async def timeouts():
    with asyncio.timeout(1):
        print(1)
    async with asyncio.timeout(1):
        print(1)
    async with asyncio.timeout(1):
        await asyncio.sleep(1)
    with trio.move_on_after(1):
        print(1)
    with trio.fail_after(1), builtins.open("x"):
        print(1)
    async with asyncio.timeout(1), builtins.open("x"):
        print(1)
    with trio.CancelScope():
        yield 1
    with asyncio.timeout_at(1):
        async for item in items():
            print(item)
    with asyncio.timeout(1):
        def inner():
            return 1
    os.waitpid(0, 0)
    os.wait()
    subprocess.run("x")


