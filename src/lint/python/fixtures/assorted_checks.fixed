def remove_affixes(filename: str, text: str, other: str) -> str:
    filename = filename[:-4] if filename.endswith(".txt") else filename
    filename = filename[4:] if filename.startswith("pre_") else filename
    filename = filename[:-4] if filename.startswith(".txt") else filename
    filename = filename[len(other):] if filename.startswith(other) else filename
    filename = filename[:-len(other)] if filename.endswith(other) else filename
    filename = filename[:-3] if filename.endswith(".txt") else filename
    filename = filename[4::2] if filename.startswith("pre_") else filename
    filename = filename[4::1] if filename.startswith("pre_") else filename
    filename = other[4:] if filename.startswith("pre_") else filename
    if text.startswith("pre"):
        text = text[3:]
    if text.endswith("post"):
        text = text[:-4]
    if text.startswith("pre"):
        text = text[3:]
    else:
        pass
    if text.startswith("pre"):
        other = text[3:]
    if text.startswith(prefix := "pre"):
        text = text[len(prefix):]
    return filename + text


