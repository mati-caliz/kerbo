def file_writes(lines, pairs):
    with builtins.open("file", "w") as handle:
        for line in lines:
            handle.write(line)
        for line in lines:
            handle.write(line.encode())
        for left, right in pairs:
            handle.write(left + right)
        for line in lines:
            handle.write(line)
        else:
            pass
        for line in lines:
            handle.write(line, 1)
        for line in lines:
            handle.write(line=line)
        for line in lines:
            handle.write(line)
            handle.flush()
        for kept in lines:
            handle.write(kept)
        print(kept)
    stream = builtins.open("file")
    for line in lines:
        stream.write(line)
    not_a_file = object()
    for line in lines:
        not_a_file.write(line)
    for line in stream.readlines():
        pass
    for line in builtins.open("x").readlines():
        pass
    for line in stream.readlines(10):
        pass
    for line in not_a_file.readlines():
        pass
    return [line for line in stream.readlines()]


async def async_writes(lines):
    with builtins.open("file", "w") as handle:
        async for line in lines:
            handle.write(line)


def format_characters(value, number):
    print("%z" % value)
    print("{:z}".format(value))
    print("{:,}".format(value))
    print("{:_d}".format(value))
    print("{:{}z}".format(value, number))
    print("{:{}}".format(value, number))
    print("{:y}{:z}".format(value, number))
    print("%d" % "1")
    print("%d" % 1)
    print("%s %d" % ("a", "b"))
    print("%s %d" % ("a", 1))
    print("%(a)d" % {"a": "x"})
    print("%(a)d" % {"a": 1})
    print("%f" % [1])
    print("%x" % 1.5)
    print("%c" % "a")
    print("%c" % "ab")
    print("%d" % None)
    print("%d %d" % (1,))
    print("%s" % value)
    print(b"%d" % b"x")


def annotations_access(cls):
    cls.__dict__.get("__annotations__")
    cls.__dict__.get("__annotations__", {})
    cls.__dict__["__annotations__"]
    cls.__dict__.get("__annotations__", {}, 1)
    cls.__dict__.get(key="__annotations__")
    cls.__dict__.get("other")
    cls.vars.get("__annotations__")
    return cls


