def counters(items):
    count = 0
    for item in items:
        print(item)
        count += 1
    index = 0
    for item in items:
        index += 1
    print(index)
    other = 0
    for item in items:
        if item:
            continue
        other += 1
    nested = 0
    for item in items:
        if item:
            nested += 1
    two = 0
    for item in items:
        two += 2
    started = 1
    for item in items:
        started += 1
    twice = 0
    for item in items:
        twice += 1
        twice += 1
    reset = 0
    for item in items:
        reset = 0
        reset += 1
    if items:
        separate = 0
    for item in items:
        separate += 1


def gettext_calls(name):
    _("Hello, {}!".format(name))
    _("Hello, %s!" % name)
    ngettext("one {}".format(name), "many {}".format(name), 2)
    _(f"Hello {name}")
    return _("Hello")


