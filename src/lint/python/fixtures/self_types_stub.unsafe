import typing
from types import TracebackType

class Shape:
    def __enter__(self) -> typing.Self: ...
    def __exit__(self, typ: type[BaseException], exc: BaseException | None, tb: TracebackType | None) -> None: ...
    def copy(self) -> typing.Self: ...

field: type[int | float] | str
union: type[int | float]
nested: type[int | str | bytes]
mixed: type[int | str] | int
tuple_type: type[int, str] | type[str]
def function(kind: type[int | str]) -> type[int | str]: ...
alias: typing.TypeAlias = type[int] | type[str]
