from types import TracebackType
from typing import TypeVar

_S = TypeVar("_S")

class Shape:
    def __enter__(self) -> Shape: ...
    def __exit__(self, typ: type[BaseException], exc: BaseException | None, tb: TracebackType | None) -> None: ...
    def copy(self: _S) -> _S: ...

field: type[int] | type[float] | str
union: type[int] | type[float]
nested: type[int] | (type[str] | type[bytes])
mixed: type[int] | (int | type[str])
tuple_type: type[int, str] | type[str]
def function(kind: type[int] | type[str]) -> type[int] | type[str]: ...
alias = type[int] | type[str]
