import builtins
import datetime
import os as os
from os import path as path


def raising(flag):
    if flag == 1:
        raise Exception("falla")
    if flag == 2:
        raise BaseException
    if flag == 3:
        raise builtins.Exception("falla")
    if flag == 4:
        raise ValueError("falla")
    if flag == 5:
        raise RuntimeError("otra") from Exception("causa")
    raise


