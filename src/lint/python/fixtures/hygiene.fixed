    try:
        pass
    except Exception:
        # comentario
        pass
    try:
        pass
    except Exception:
        pass


def executing(code, exec_code):
    exec(code)
    builtins.exec(code)
    exec_code(code)


def keys(mapping, self):
    if "a" in mapping.keys():
        pass
    if "a" not in mapping.keys():
        pass
    if ("a") in (mapping.keys()):
        pass
    if "a" in self.keys():
        pass
    if "a" in mapping.keys(1):
        pass
    if "a" in mapping.keys() in mapping:
        pass
    for key in mapping.keys():
        pass
    return [key for key in mapping.keys()]


def utc():
    first = datetime.UTC
    second = datetime.UTC
    return first, second, datetime.UTC


def literals():
    return [
        "",
        "texto",
        "a" "b",
        str(f"{literals}"),
        "x",
        str(1),
        b"x",
        bytes("x"),
        0,
        1,
        (-1),
        int(1.0),
        1.0,
        (+1.5),
        float(1),
        True,
        bool(1),
        1j,
        1j,
        int(1, 2),
        int(x=1),
    ]


def formats(first, second, values):
    return [
        f"{first} {second}",
        f"{second} {first}",
        "{1} {0}".format(first),
        "{1} {0}".format(*values),
        f"{first} {first}",
        f"{first} {second}",
        f"{first} {second}",
        "{0:{1}}".format(first, second),
        f"{first}",
        f"{first.real} {second[0]}",
    ]


def unpacking(pair, rows):
    first, second = pair
    (third, fourth), fifth = pair, rows
    _, sixth = pair
    for key, value in rows:
        print(key)
    with open(pair) as (handle, other):
        print(handle)
    return first, third
