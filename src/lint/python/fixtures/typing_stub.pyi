from collections.abc import Set
from typing import NoReturn

class Shown:
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Typed:
    def __str__(self, extra: int) -> str: ...
    def __repr__(self) -> int: ...

class Abstract:
    @staticmethod
    def __str__() -> str: ...

def never(value: NoReturn) -> None: ...
def uses(value: Set[int]) -> None: ...
