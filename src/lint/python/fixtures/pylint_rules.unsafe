import abc
import functools
from enum import property as enum_property

value = 1
items = [1, 2]

print(value)
print(value)
x = (value)
y = ((value, value))
z = (())
w = (yield_value for yield_value in items)
v = (
    value
)
u = (  # comentario
    value
)
t = ((value) + 1)
s = [(value)]
r = f"{(value)}"
q = ((value)[0])
p = (value)


class Single:
    __slots__ = "name"


class Annotated:
    __slots__: str = "name"


class Many:
    __slots__ = ("name",)


class Grouped:
    __slots__ = ("name")


class Formatted:
    __slots__ = f"{value}"


class Chained:
    other = __slots__ = "name"


class Raw:
    __slots__ = b"name"


class Nested:
    if value:
        __slots__ = "name"


for item in items:
    print(item)
else:
    print("fin")

for item in items:
    if item:
        break
else:
    print("fin")

while value:
    with open("f") as handle:
        break
else:
    print("fin")

for item in items:
    for inner in items:
        break
else:
    print("fin")

for item in items:
    for inner in items:
        pass
    else:
        break
else:
    print("fin")

for item in items:
    try:
        pass
    except ValueError:
        break
else:
    print("fin")

for item in items:
    match item:
        case 1:
            break
else:
    print("fin")

for item in items:
    def helper():
        pass
else:
    print("fin")


def none_only(flag):
    if flag:
        return
    return


def mixed(flag):
    if flag:
        return None
    return 1


def bare(flag):
    if flag:
        return
    return


def single():
    return None


def generator(flag):
    if flag:
        return None
    yield 1


def annotated(flag) -> int:
    if flag:
        return None
    return None


def annotated_none(flag) -> None:
    if flag:
        return
    return


class Holder:
    @property
    def attribute(self):
        print(self)

    @functools.cached_property
    def cached(self):
        print(self)

    @abc.abstractproperty
    def abstract(self):
        print(self)

    @enum_property
    def member(self):
        print(self)

    @staticmethod
    def static():
        print(1)


def outer(flag):
    def inner():
        return 1

    if flag:
        return
    return


def nested_generator(flag):
    def inner():
        yield 1

    if flag:
        return
    return


def lambda_yield(flag):
    lambda: (yield)
    if flag:
        return None
    return None
