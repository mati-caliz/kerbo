import builtins
import datetime


def raising(flag):
    if flag == 1:
        raise Exception("falla")
    if flag == 2:
        raise BaseException
    if flag == 3:
        raise builtins.Exception("falla")
    if flag == 4:
        raise ValueError("falla")
    if flag == 5:
        raise RuntimeError("otra") from Exception("causa")
    raise


def silenced():
    try:
        pass
    except:
        pass
    try:
        pass
    except Exception:
        pass
    try:
        pass
    except (ValueError, Exception):
        pass
    try:
        pass
    except ValueError:
        pass
    try:
        pass
    except Exception:
        # comentario
        pass
    try:
        pass
    except Exception:
        pass


def executing(code, exec_code):
    exec(code)
    builtins.exec(code)
    exec_code(code)


def keys(mapping, self):
    if "a" in mapping:
        pass
    if "a" not in mapping:
        pass
    if ("a") in (mapping):
        pass
    if "a" in self.keys():
        pass
    if "a" in mapping.keys(1):
        pass
    if "a" in mapping.keys() in mapping:
        pass
    for key in mapping:
        pass
    return [key for key in mapping]


def utc():
    first = datetime.UTC
    second = datetime.UTC
    return first, second, datetime.UTC


def literals():
    return [
        "",
        "texto",
        ("a" "b"),
        str(f"{literals}"),
        "x",
        str(1),
        b"x",
        bytes("x"),
        0,
        1,
        (-1),
        int(1.0),
        1.0,
        (+1.5),
        float(1),
        True,
        bool(1),
        1j,
        1j,
        int(1, 2),
        int(x=1),
    ]


def formats(first, second, values):
    return [
        "{} {}".format(first, second),
        "{} {}".format(second, first),
        "{1} {0}".format(first),
        "{1} {0}".format(*values),
        "{0} {0}".format(first),
        "{} {}".format(first, second),
        "{0} {name}".format(first, name=second),
        "{0:{1}}".format(first, second),
        "{}".format(first, ),
        "{.real} {[0]}".format(first, second),
    ]


def unpacking(pair, rows):
    first, _second = pair
    (third, _fourth), _fifth = pair, rows
    _, _sixth = pair
    for key, value in rows:
        print(key)
    with open(pair) as (handle, _other):
        print(handle)
    return first, third
