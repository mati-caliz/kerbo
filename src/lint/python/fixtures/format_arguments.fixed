"""Argumentos de más en `%` y `.format`: comas, espacios y efectos."""


def compute():
    return 1


"%(a)s" % {"a": 1,  }
"%(a)s" % {"a": 1,  }
"%(a)s" % { "a": 1 }
"%(a)s" % {"a": 1, "b": compute()}
"%(a)s" % {"a": compute(), "b": 2}
"%(a)s" % {"a": 1, 2: 3, }
f"{1}"
f"{1}"
f"{1}"
f"{1}"
f"{1}"
f"{compute()}"
f"{1}"
f"{1}"
f"{1}"
"{0}".format(1,  # comentario
             )
"hola"
"hola" "chau"
"{{}}".format()
f"{1}"
f"{2}"
f"{1}{3}"
f"{1}"
"%(a)s" % {
    "a": 1,
    
}
