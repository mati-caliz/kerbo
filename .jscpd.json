    "**/conftest.py",
    "**/tests/**",
    "**/__tests__/**",
    "**/__fixtures__/**",
    "**/e2e/**",
    "**/test/**",
    "**/testdata/**",
    "**/testing/**",
    "**/migrations/**",
    "**/alembic/**",
    "**/drizzle/**",
