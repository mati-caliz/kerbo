{
  "format": ["typescript", "tsx", "javascript", "jsx", "python", "go", "rust", "bash"],
  "minTokens": 50,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/.astro/**",
    "**/coverage/**",
    "**/.venv/**",
    "**/vendor/**",
    "**/public/**",
    "**/*.min.js",
    "**/*.gen.go",
    "**/*.test.*",
    "**/*.spec.*",
